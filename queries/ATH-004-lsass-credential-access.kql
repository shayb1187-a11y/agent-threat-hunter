// =====================================================================================
// ATH-004 : Possible LSASS credential access
// Severity: CRITICAL
// Pandas  : src/ath/hunting/rules/process_rules.py :: LsassCredentialAccess
//
// LSASS holds credential material for logged-on sessions. Dumping it is the hinge
// between "code execution on one laptop" and "credentials for the domain".
//
// This file has TWO queries. Query A is the command-line version our pandas rule
// implements. Query B is the handle-based version, which is strictly better and which
// our telemetry cannot support -- included so the gap is documented rather than hidden.
//
// KQL notes:
//   union            stacks two result sets   ~  pd.concat([...])
//   binary_and()     bitmask test, for access rights
//   has_any          fast multi-term match
// =====================================================================================

// -------------------------------------------------------------------------------------
// REQUIRED TELEMETRY FIELDS (our synthetic schema)
//   process_events: timestamp, device, user, process_name, parent_process_name,
//            command_line, event_id
//
// SYNTHETIC SCHEMA vs MICROSOFT DEFENDER / SENTINEL
// Query A maps to DeviceProcessEvents. Query B has NO equivalent in our schema at all:
// it needs Defender's DeviceEvents table with ActionType == 'OpenProcess' and the
// DesiredAccess mask in AdditionalFields. We do not model process-handle telemetry,
// so the Python rule is command-line-only and blind to API-based dumping. That is a
// real detection gap, documented rather than hidden.
//
// LIKELY FALSE POSITIVES
//   - IT support capturing an LSASS dump to debug authentication (procdump is legit).
//   - EDR/DFIR products that read LSASS memory by design.
//   - Red-team exercises and detection-validation runs.
// -------------------------------------------------------------------------------------

// ---------------------------------------------------------------------------- Query A
// Command-line indicators. Cheap, catches tool-based dumping (procdump, comsvcs.dll,
// Mimikatz). MISSES an implant that calls MiniDumpWriteDump() directly from its own
// process -- that produces no command line at all.
let LookBack = 7d;
DeviceProcessEvents
| where Timestamp > ago(LookBack)
// `has_any` uses the term index and is far cheaper than the regex that follows.
| where ProcessCommandLine has_any ("lsass", "comsvcs", "sekurlsa", "procdump",
                                    "MiniDump", "lsadump", "logonpasswords")
| extend Indicator = case(
    ProcessCommandLine matches regex @"(?i)comsvcs\.dll.{0,40}minidump", "comsvcs.dll MiniDump",
    ProcessCommandLine matches regex @"(?i)procdump(64)?\.exe.{0,60}lsass",  "procdump against lsass",
    ProcessCommandLine has "sekurlsa::",                                     "mimikatz sekurlsa",
    ProcessCommandLine has_any ("lsadump", "logonpasswords"),                "credential dump keyword",
    ProcessCommandLine has "lsass",                                          "explicit lsass reference",
    "other")
| project
    Timestamp, DeviceName, AccountName, Indicator,
    FileName, InitiatingProcessFileName, ProcessCommandLine, ReportId
| sort by Timestamp asc

// ---------------------------------------------------------------------------- Query B
// Handle-based detection. THIS is what you would actually deploy: it observes a process
// opening a handle to lsass.exe with memory-read rights, regardless of command line.
//
//   0x0010 = PROCESS_VM_READ
//   0x0400 = PROCESS_QUERY_INFORMATION
//   0x1010 = the combination a memory dump requires
//
// Requires DeviceEvents, which our synthetic dataset does not model. Stated as a known
// blind spot rather than quietly omitted.
//
// DeviceEvents
// | where Timestamp > ago(7d)
// | where ActionType == "OpenProcess"
// | where FileName =~ "lsass.exe"
// | extend Access = tolong(parse_json(AdditionalFields).DesiredAccess)
// | where binary_and(Access, 0x0010) != 0          // PROCESS_VM_READ requested
// | where InitiatingProcessFileName !in~ ("MsMpEng.exe", "csrss.exe", "wininit.exe")
// | project Timestamp, DeviceName, InitiatingProcessFileName,
//           InitiatingProcessCommandLine, Access, ReportId

// pandas equivalent (Query A only):
//   matched = [n for n, p in _LSASS_PATTERNS.items() if re.search(p, command_line)]
