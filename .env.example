# Copy to .env and fill in. .env is git-ignored and must NEVER be committed.

# Only required for the agent layer (Milestone 5+).
ATH_LLM_API_KEY=
ATH_LLM_MODEL=claude-sonnet-4-6

# Only required for durable background investigation jobs (`ath jobs submit|work`).
# Without it, `ath jobs run` uses an in-memory store for a single process.
# ATH_DATABASE_URL=postgresql://ath:secret@localhost:5432/ath

# Optional overrides
ATH_LOG_LEVEL=INFO
# ATH_RAW_DATA_DIR=./data/raw
# ATH_REPORTS_DIR=./reports
