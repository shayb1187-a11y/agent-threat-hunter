# Secrets -- never commit
.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# Generated artefacts (regenerate with `python main.py generate`)
reports/*.md
reports/*.json
!reports/.gitkeep

# OS
.DS_Store

# External validation datasets (M14): fetched by scripts/fetch_external.py, never committed
data/external/*
!data/external/MANIFEST.json
!data/external/dedale_winlogbeat_zip_index.json

# Injected DEDALE case logs (V1 local stage): regenerable with
# `scripts/local_inject_dedale.py` (seed + source/output sha256 pinned in the
# case MANIFEST.json, which IS committed). ~94 MB, so kept out of the repo.
reports/local/**/winlogbeat/

# Local scratch working file, stripped from history in the M19 cleanup -- never commit
data/raw/control_events.csv

# COMISET canonical freezes (inputs to M17 / M18b, ~110 MB, derived from a 159.7 GB
# archive member). External data is fetched, never committed; these were removed from
# the tree and from history before publication. Re-derive with scripts/comiset_slice.py
# and check against the sha256s in each canonical/README.md.
reports/m17/canonical/*.parquet
reports/m18b/canonical/*.parquet

# Scripted (smoke-test) ablation rows can be hundreds of MB; the real M19 rows live one
# directory up and are size-guarded by tests/test_artifact_size_guard.py.
reports/m19/ablation/scripted/arm_B.json
