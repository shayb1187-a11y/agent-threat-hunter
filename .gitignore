.DS_Store

# External validation datasets (M14): fetched by scripts/fetch_external.py, never committed
data/external/*
!data/external/MANIFEST.json
!data/external/dedale_winlogbeat_zip_index.json

# Injected DEDALE case logs (V1 local stage): regenerable with
# `scripts/local_inject_dedale.py` (seed + source/output sha256 pinned in the
# case MANIFEST.json, which IS committed). ~94 MB, so kept out of the repo.
reports/local/**/winlogbeat/

# Local scratch working file, stripped from history in the M19 cleanup -- never commit
data/raw/control_events.csv
